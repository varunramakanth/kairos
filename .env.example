# Copy to .env (git-ignored). `just` loads .env automatically.
# Never commit real secrets. Every variable the code reads must be listed here.

# --- Local Postgres (infra/compose.yaml) ---------------------------------------
KAIROS_DB_USER=kairos
KAIROS_DB_PASSWORD=kairos
KAIROS_DB_NAME=kairos
KAIROS_DB_PORT=5432

# --- Local Langfuse (`just dev-obs`, http://localhost:3100) --------------------
# Local-only defaults; the compose file pre-creates a project with these keys.
LANGFUSE_PORT=3100
LANGFUSE_PUBLIC_KEY=pk-lf-kairos-local
LANGFUSE_SECRET_KEY=sk-lf-kairos-local
LANGFUSE_INIT_USER_EMAIL=dev@kairos.local
LANGFUSE_INIT_USER_PASSWORD=kairos-local-password
# Optional overrides: LANGFUSE_IMAGE_TAG, LANGFUSE_SALT, LANGFUSE_ENCRYPTION_KEY,
# LANGFUSE_NEXTAUTH_SECRET

# --- Tests ---------------------------------------------------------------------
# LIVE=1 lets tests marked `live` reach real services. Costs money. Leave unset.
# LIVE=1

# --- Model providers (first used in M1) ----------------------------------------
# Anthropic API. Leave unset if you use an `ant auth login` profile instead.
# ANTHROPIC_API_KEY=
# Amazon Bedrock uses the standard AWS credential chain.
# AWS_PROFILE=
# AWS_REGION=
