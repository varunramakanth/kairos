# Copy to .env (git-ignored). `just` loads .env automatically.
# Never commit real secrets. Every variable the code reads must be listed here.

# --- Local Postgres (infra/compose.yaml) ---------------------------------------
KAIROS_DB_USER=kairos
KAIROS_DB_PASSWORD=kairos
KAIROS_DB_NAME=kairos
KAIROS_DB_PORT=5432

# --- Local Langfuse (`just dev-obs`, http://localhost:3100) --------------------
# Local-only defaults; the compose file pre-creates a project with these keys.
LANGFUSE_PORT=3100
LANGFUSE_PUBLIC_KEY=pk-lf-kairos-local
LANGFUSE_SECRET_KEY=sk-lf-kairos-local
LANGFUSE_INIT_USER_EMAIL=dev@kairos.local
LANGFUSE_INIT_USER_PASSWORD=kairos-local-password
# Optional overrides: LANGFUSE_IMAGE_TAG, LANGFUSE_SALT, LANGFUSE_ENCRYPTION_KEY,
# LANGFUSE_NEXTAUTH_SECRET

# --- Tests ---------------------------------------------------------------------
# LIVE=1 lets tests marked `live` reach real services. Costs money. Leave unset.
# LIVE=1

# Spend cap for `just record-evals` (live eval recording), in USD. Default 2.50.
# KAIROS_EVALS_MAX_USD=2.50

# Set to 1 to fail (not skip) integration tests when Docker is unavailable. CI sets it.
# KAIROS_REQUIRE_DOCKER=1

# --- Worker and CLI (kairos_worker.settings) -----------------------------------
KAIROS_DATABASE_URL=postgresql+asyncpg://kairos:kairos@localhost:5432/kairos
# anthropic | bedrock | replay (replay serves KAIROS_REPLAY_CASSETTE: no network, no cost)
KAIROS_PROVIDER=anthropic
# KAIROS_REPLAY_CASSETTE=tests/e2e/cassettes/demo.jsonl
KAIROS_MODEL=claude-opus-5-5
# Model for scheduled tasks and watches (unless a job names its own).
KAIROS_JOB_MODEL=claude-haiku-5-5
# The user's IANA timezone: default for schedules and how times are shown.
KAIROS_TIMEZONE=America/Toronto
KAIROS_SCHEDULER_POLL_SECONDS=5
# Bedrock only. Current Claude models need a cross-region inference profile
# prefix, e.g. us.anthropic. or global.anthropic.
# KAIROS_BEDROCK_REGION=ca-central-1
# KAIROS_BEDROCK_MODEL_PREFIX=anthropic.
KAIROS_LEASE_TTL_SECONDS=60
KAIROS_POLL_SECONDS=1
KAIROS_MAX_ATTEMPTS=5
# Compact a run's context into a summary once its prompt would exceed this many tokens.
KAIROS_COMPACT_AT_PROMPT_TOKENS=150000

# --- API (services/api) ---------------------------------------------------------
# Run a worker inside the API process (`just api` sets this). Off in production.
# KAIROS_EMBEDDED_WORKER=1
# Browser origins allowed to call the API, as a JSON list.
# KAIROS_CORS_ORIGINS=["http://localhost:3000"]

# --- Notifications (M4) -----------------------------------------------------------
# Email through Amazon SES with a send-only IAM policy (docs/ses-setup.md).
# Credentials: the AWS profile named in KAIROS_SES_PROFILE (in ~/.aws, never in .env).
# KAIROS_EMAIL_PROVIDER=ses
# KAIROS_EMAIL_TO=you@example.com
# KAIROS_EMAIL_FROM=            # verified SES sender; defaults to KAIROS_EMAIL_TO
# KAIROS_SES_REGION=ca-central-1
# KAIROS_SES_PROFILE=kairos-ses    # AWS profile with only the send-only policy
# Alternative (not recommended for a personal Gmail account): plain SMTP.
# KAIROS_EMAIL_PROVIDER=smtp
# KAIROS_SMTP_USERNAME=
# KAIROS_SMTP_PASSWORD=
# KAIROS_SMTP_HOST=smtp.gmail.com
# KAIROS_SMTP_PORT=587
# Web Push keys: generate with `uv run kairos vapid-keys` and paste both lines here.
# KAIROS_VAPID_PUBLIC_KEY=
# KAIROS_VAPID_PRIVATE_KEY=
# Base URL used in notification links.
# KAIROS_WEB_BASE_URL=http://localhost:3000

# --- Web UI (apps/web) ----------------------------------------------------------
# Where the browser finds the API. Read at build time by Next.js.
# NEXT_PUBLIC_KAIROS_API_URL=http://localhost:8000
# OTLP/HTTP trace export. For local Langfuse (`just dev-obs`):
#   KAIROS_OTLP_ENDPOINT=http://localhost:3100/api/public/otel
#   KAIROS_OTLP_HEADERS=Authorization=Basic <base64 of public:secret>,x-langfuse-ingestion-version=4
# kairos_telemetry.langfuse_headers() builds the header values.
# KAIROS_OTLP_ENDPOINT=
# KAIROS_OTLP_HEADERS=

# --- Model provider credentials ------------------------------------------------
# Anthropic API. Leave unset if you use an `ant auth login` profile instead.
# ANTHROPIC_API_KEY=
# Tavily Search API key; enables the web_search tool. Paid service with a free tier.
# TAVILY_API_KEY=

# Flight search (flights_search tool): Google Flights via SerpApi. Create a free account at
# serpapi.com (about 250 searches a month). Without a key the tool is not offered.
# SERPAPI_API_KEY=

# --- Hardening (M7, ADR-015) ---
# Stop runs and job firings for the rest of the day once model spend reaches this (USD).
# KAIROS_DAILY_SPEND_CAP_USD=5
# Injection screening of untrusted tool output: model (default), patterns, or off.
# KAIROS_INJECTION_SCREENING=model
# Nightly local backups by the worker (after 03:00 local time), kept 14 days.
# KAIROS_BACKUPS=true
# KAIROS_BACKUP_DIR=~/Backups/kairos
# KAIROS_BACKUP_KEEP_DAYS=14
# Requests per minute per client to endpoints that start work.
# KAIROS_RATE_LIMIT_PER_MINUTE=20

# --- Deployment (M8, ADR-017). Set by the CDK stack in AWS; unset locally. ---
# Serve the API under this prefix (CloudFront sends /api/* to the API).
# KAIROS_PATH_PREFIX=/api
# Cognito sign-in. With an issuer and client id set, every API request except /health and
# /auth/config needs a valid access token. The domain is the Hosted UI base URL.
# KAIROS_AUTH_ISSUER=https://cognito-idp.ca-central-1.amazonaws.com/<pool id>
# KAIROS_AUTH_CLIENT_ID=
# KAIROS_AUTH_DOMAIN=https://<prefix>.auth.ca-central-1.amazoncognito.com
# Score every finished run with label-free metrics (the "online" suite on /evals).
# KAIROS_ONLINE_EVALS=true
# KAIROS_ONLINE_EVALS_FLUSH_SECONDS=21600

# --- Subagents and memory (M6, ADR-013) ---
# Model for `delegate` children (read-only research). Default claude-sonnet-5-5.
# KAIROS_SUBAGENT_MODEL=claude-sonnet-5-5
# After each completed chat turn, propose memories from it with the job model (one small
# model call per turn). Proposals wait for your confirmation on the Memory page.
# KAIROS_MEMORY_REFLECTION=1

# --- Browser and MCP servers (M6, ADR-012) ---
# Offer the isolated browser (browser_* tools). Needs `uv run playwright install chromium`
# (`just sync` does it). Reading is allowed; typing into forms and pressing buttons need
# approval; every page is untrusted content.
# KAIROS_BROWSER=1
# Extra MCP servers as JSON. Their tools need approval and their output is untrusted unless
# a server's "tools" entry says otherwise, e.g.
# KAIROS_MCP_SERVERS=[{"name":"weather","command":"uvx","args":["some-weather-mcp"],"tools":{"forecast":{"risk":"read","idempotent":true}}}]
# Amazon Bedrock uses the standard AWS credential chain.
# AWS_PROFILE=
# AWS_REGION=
